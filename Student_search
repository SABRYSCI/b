<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام إدارة الطلاب | مدرسة البلاد القديم</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Cairo', 'sans-serif'] },
                    colors: {
                        primary: { 50: '#eff6ff', 100: '#dbeafe', 500: '#3b82f6', 600: '#2563eb', 800: '#1e40af', 900: '#1e3a8a' }
                    }
                }
            }
        }
    </script>

    <style>
        body { background-color: #f8fafc; }
        
        /* Custom Scrollbar for Search */
        #searchResults::-webkit-scrollbar { width: 6px; }
        #searchResults::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 8px; }
        #searchResults::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 8px; }
        
        /* Loading Overlay */
        #loadingOverlay {
            position: fixed; inset: 0; background: rgba(255, 255, 255, 0.9); z-index: 9999;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            backdrop-filter: blur(5px);
        }
        .loader {
            width: 60px; height: 60px; border: 5px solid #dbeafe; border-bottom-color: #2563eb;
            border-radius: 50%; display: inline-block; box-sizing: border-box; animation: rotation 1s linear infinite;
        }
        @keyframes rotation { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

        /* Print Settings */
        @media print {
            body { background: white; }
            .print-hidden { display: none !important; }
            .print-only { display: block !important; }
            .print-break-inside-avoid { page-break-inside: avoid; }
            .container { max-width: 100% !important; padding: 0 !important; margin: 0 !important; }
            .shadow-sm, .shadow-md { box-shadow: none !important; border: 1px solid #e2e8f0; }
        }
    </style>
</head>
<body class="text-gray-800 antialiased font-sans">

    <!-- شاشة التحميل -->
    <div id="loadingOverlay">
        <span class="loader"></span>
        <h2 class="mt-4 text-xl font-bold text-primary-900">جاري الاتصال بقاعدة البيانات...</h2>
        <p class="text-gray-500 mt-2 text-sm">يرجى الانتظار، يتم جلب السجلات</p>
    </div>

    <!-- الهيدر الرئيسي -->
    <header class="bg-primary-900 text-white shadow-md print-hidden sticky top-0 z-50">
        <div class="container mx-auto px-4 py-4 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="bg-white text-primary-900 p-3 rounded-xl shadow-inner">
                    <i class="fa-solid fa-graduation-cap text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-black tracking-wide">نظام إدارة الطلاب</h1>
                    <p class="text-primary-100 text-sm">مدرسة البلاد القديم الابتدائية الإعدادية للبنين</p>
                </div>
            </div>
            <div class="flex items-center gap-3 bg-primary-800 px-5 py-2 rounded-lg border border-primary-700">
                <i class="fa-solid fa-calendar-check text-primary-100"></i>
                <span class="font-semibold text-sm">العام الدراسي 2026 - 2027</span>
            </div>
        </div>
    </header>

    <main class="container mx-auto px-4 py-8">
        
        <!-- قسم البحث -->
        <section class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-8 print-hidden">
            <h2 class="text-xl font-bold text-gray-800 mb-6 border-b pb-3 flex items-center gap-2">
                <i class="fa-solid fa-magnifying-glass text-primary-600"></i> البحث الشامل
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                <!-- البحث النصي -->
                <div class="md:col-span-6 relative">
                    <label class="block text-sm font-bold text-gray-600 mb-2">بحث سريع (الاسم أو الرقم الشخصي)</label>
                    <div class="relative">
                        <input type="text" id="searchInput" placeholder="اكتب اسم الطالب أو رقمه الشخصي هنا..." autocomplete="off"
                            class="w-full pl-10 pr-12 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-gray-50 focus:bg-white transition-all">
                        <i class="fa-solid fa-search absolute right-4 top-4 text-gray-400"></i>
                        <button id="clearSearch" class="absolute left-4 top-4 text-gray-400 hover:text-red-500 hidden">
                            <i class="fa-solid fa-times"></i>
                        </button>
                    </div>
                    <!-- نتائج البحث -->
                    <div id="searchResults" class="absolute z-50 w-full bg-white border border-gray-200 rounded-xl shadow-xl mt-2 hidden max-h-64 overflow-y-auto"></div>
                </div>

                <!-- البحث بالقوائم -->
                <div class="md:col-span-3">
                    <label class="block text-sm font-bold text-gray-600 mb-2">تصفية بالصف</label>
                    <div class="relative">
                        <select id="classSelect" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-primary-500 appearance-none bg-gray-50 focus:bg-white cursor-pointer transition-all">
                            <option value="">-- كل الصفوف --</option>
                        </select>
                        <i class="fa-solid fa-chevron-down absolute left-4 top-4 text-gray-400 pointer-events-none"></i>
                    </div>
                </div>

                <div class="md:col-span-3">
                    <label class="block text-sm font-bold text-gray-600 mb-2">اختر الطالب</label>
                    <div class="relative">
                        <select id="studentSelect" disabled class="w-full px-4 py-3 rounded-xl border border-gray-300 appearance-none bg-gray-100 text-gray-500 cursor-not-allowed">
                            <option value="">-- اختر الطالب --</option>
                        </select>
                        <i class="fa-solid fa-chevron-down absolute left-4 top-4 text-gray-400 pointer-events-none"></i>
                    </div>
                </div>
            </div>
        </section>

        <!-- ترويسة الطباعة المخفية -->
        <div class="hidden print-only mb-8 border-b-4 border-gray-800 pb-6 text-center">
            <h1 class="text-3xl font-black mb-2">تقرير الطالب الشامل</h1>
            <h2 class="text-xl text-gray-600">مدرسة البلاد القديم الابتدائية الإعدادية للبنين</h2>
            <p class="text-gray-500 mt-2 font-semibold" id="printDate"></p>
        </div>

        <!-- ملف الطالب (مخفي افتراضياً) -->
        <section id="studentProfile" class="hidden animate-[fadeIn_0.5s_ease-out]">
            
            <!-- أزرار الإجراءات -->
            <div class="flex flex-wrap justify-between items-center mb-6 print-hidden gap-4">
                <h2 class="text-2xl font-black text-gray-800 border-r-4 border-primary-600 pr-3">الملف الإلكتروني للطالب</h2>
                <div class="flex gap-3">
                    <button onclick="window.print()" class="bg-gray-800 hover:bg-black text-white px-5 py-2.5 rounded-xl shadow-md transition-all flex items-center gap-2 font-bold">
                        <i class="fa-solid fa-print"></i> طباعة التقرير
                    </button>
                </div>
            </div>

            <!-- بطاقة البيانات الأساسية -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 mb-8 print-break-inside-avoid relative overflow-hidden">
                <div class="absolute top-0 right-0 w-2 h-full bg-primary-600"></div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div class="lg:col-span-2">
                        <p class="text-sm font-bold text-gray-400 mb-1">الاسم الرباعي</p>
                        <p class="font-black text-2xl text-primary-900" id="profileName">-</p>
                    </div>
                    <div>
                        <p class="text-sm font-bold text-gray-400 mb-1">الفرقة / الصف</p>
                        <span class="inline-block bg-primary-100 text-primary-800 font-bold px-3 py-1 rounded-lg text-lg" id="profileClass">-</span>
                    </div>
                    <div>
                        <p class="text-sm font-bold text-gray-400 mb-1">الرقم الشخصي</p>
                        <p class="font-bold text-xl text-gray-700 font-mono tracking-wider bg-gray-50 inline-block px-3 py-1 rounded-lg border" id="profileCpr">-</p>
                    </div>
                </div>
            </div>

            <!-- الجداول التفصيلية -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
                
                <!-- سجل الغياب والأعذار -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-200 flex flex-col print-break-inside-avoid">
                    <div class="bg-red-50 p-4 rounded-t-2xl border-b border-red-100 flex justify-between items-center">
                        <h3 class="text-lg font-black text-red-700 flex items-center gap-2">
                            <i class="fa-solid fa-calendar-xmark text-xl"></i> سجل الغياب والأعذار
                        </h3>
                        <span class="bg-white border border-red-200 text-red-600 font-bold px-4 py-1 rounded-full shadow-sm">
                            العدد: <span id="absencesCount">0</span>
                        </span>
                    </div>
                    <div class="p-0 flex-1 overflow-x-auto">
                        <table class="w-full text-right text-sm">
                            <thead class="bg-gray-50 text-gray-500 font-semibold border-b">
                                <tr>
                                    <th class="p-4">التاريخ</th>
                                    <th class="p-4">تفاصيل العذر / الحالة</th>
                                </tr>
                            </thead>
                            <tbody id="absencesTable" class="divide-y divide-gray-100"></tbody>
                        </table>
                    </div>
                </div>

                <!-- سجل التأخير -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-200 flex flex-col print-break-inside-avoid">
                    <div class="bg-orange-50 p-4 rounded-t-2xl border-b border-orange-100 flex justify-between items-center">
                        <h3 class="text-lg font-black text-orange-700 flex items-center gap-2">
                            <i class="fa-solid fa-clock text-xl"></i> سجل التأخير الصباحي
                        </h3>
                        <span class="bg-white border border-orange-200 text-orange-600 font-bold px-4 py-1 rounded-full shadow-sm">
                            العدد: <span id="latesCount">0</span>
                        </span>
                    </div>
                    <div class="p-0 flex-1 overflow-x-auto">
                        <table class="w-full text-right text-sm">
                            <thead class="bg-gray-50 text-gray-500 font-semibold border-b">
                                <tr>
                                    <th class="p-4">التاريخ</th>
                                    <th class="p-4">نوع التأخير / العذر</th>
                                </tr>
                            </thead>
                            <tbody id="latesTable" class="divide-y divide-gray-100"></tbody>
                        </table>
                    </div>
                </div>

            </div>

            <!-- سجل المخالفات السلوكية -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 flex flex-col mb-8 print-break-inside-avoid">
                <div class="bg-purple-50 p-4 rounded-t-2xl border-b border-purple-100 flex justify-between items-center">
                    <h3 class="text-lg font-black text-purple-700 flex items-center gap-2">
                        <i class="fa-solid fa-triangle-exclamation text-xl"></i> المخالفات السلوكية
                    </h3>
                    <span class="bg-white border border-purple-200 text-purple-600 font-bold px-4 py-1 rounded-full shadow-sm">
                        العدد: <span id="violationsCount">0</span>
                    </span>
                </div>
                <div class="p-0 overflow-x-auto">
                    <table class="w-full text-right text-sm">
                        <thead class="bg-gray-50 text-gray-500 font-semibold border-b">
                            <tr>
                                <th class="p-4">تاريخ التسجيل</th>
                                <th class="p-4">المشرف المسؤول</th>
                                <th class="p-4 w-1/3">نوع المخالفة والتفاصيل</th>
                                <th class="p-4 w-1/3">الإجراء المتخذ</th>
                            </tr>
                        </thead>
                        <tbody id="violationsTable" class="divide-y divide-gray-100"></tbody>
                    </table>
                </div>
            </div>

        </section>
    </main>

    <!-- توست الإشعارات -->
    <div id="toast" class="fixed bottom-6 left-6 text-white px-6 py-4 rounded-xl shadow-2xl flex items-center gap-3 transition-all duration-300 opacity-0 translate-y-10 pointer-events-none z-50">
        <i id="toastIcon" class="fa-solid text-2xl"></i>
        <span id="toastMessage" class="font-bold"></span>
    </div>

    <script>
        // ==========================================
        // 🔴 الإعدادات الأساسية 🔴
        // ==========================================
        const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxlJnpJN9y9h04cOswtY3BGGwUS8rhybOisxDFkIQJ6_9nFSPMJeK-wiuFEECnBY3v5/exec"; 
        
        // المتغيرات العامة لتخزين البيانات
        let globalData = {
            rosters: {},
            cprMap: {},
            absences: [], // من سجل الغياب المنظم
            excuses: [],  // من سجل الأعذار
            lates: [],    // من سجل التأخير
            violations: [] // من سجل المخالفات
        };
        let searchableStudents = []; // مصفوفة لتسهيل البحث (الاسم، الصف، الرقم)

        document.addEventListener('DOMContentLoaded', () => {
            // ضبط تاريخ الطباعة
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('printDate').innerText = new Date().toLocaleDateString('ar-BH', options);
            
            // تهيئة النظام
            initSystem();
        });

        // ==========================================
        // جلب البيانات من السيرفر
        // ==========================================
        async function initSystem() {
            showLoading(true);
            try {
                // نطلب البيانات العامة (غياب، تأخير، أعذار، أسماء)
                const req1 = fetch(`${SCRIPT_URL}?action=dashboard_data&pass=admin123`);
                // نطلب المخالفات
                const req2 = fetch(`${SCRIPT_URL}?action=getViolations`);

                const [res1, res2] = await Promise.all([req1, req2]);
                const data1 = await res1.json();
                const data2 = await res2.json();

                if (data1.status === "success") {
                    globalData.cprMap = data1.cprMap || {};
                    globalData.absences = data1.records || [];
                    globalData.lates = data1.lates || [];
                    globalData.excuses = data1.excuses || [];
                    
                    // استخراج القوائم من البيانات (سنعتمد على cprMap لبناء قائمة الطلاب)
                    // بما أن التطبيق يحتاج القوائم المحدثة، سنبنيها من السجلات
                    buildSearchIndex(data1);
                    populateClassDropdown();
                    showToast("تم مزامنة قاعدة البيانات بنجاح", "success");
                } else {
                    throw new Error(data1.message || "فشل جلب البيانات الأساسية");
                }

                if (data2.status === "success") {
                    globalData.violations = data2.data || [];
                }

            } catch (error) {
                console.error(error);
                showToast("حدث خطأ أثناء الاتصال بقاعدة البيانات. تأكد من الرابط.", "error");
            } finally {
                showLoading(false);
            }
        }

        // ==========================================
        // معالجة البيانات وبناء الفهارس
        // ==========================================
        function buildSearchIndex(data) {
            searchableStudents = [];
            let classesSet = new Set();

            // نمر على قائمة الأرقام الشخصية التي تم جلبها من "قاعدة البيانات المحدثة"
            for (let studentName in data.cprMap) {
                // لمحاولة معرفة الصف، سنبحث عنه في سجلات الغياب أو التأخير
                let studentClass = "غير محدد";
                let foundRecord = data.records.find(r => r.studentName.includes(studentName)) || 
                                  data.lates.find(l => l.studentName.includes(studentName));
                
                if (foundRecord) {
                    studentClass = foundRecord.className;
                    classesSet.add(studentClass);
                }

                searchableStudents.push({
                    name: studentName,
                    cpr: data.cprMap[studentName] || "غير مسجل",
                    class: studentClass
                });
            }

            // ترتيب الصفوف وإضافتها للدروب داون
            globalData.classesList = Array.from(classesSet).sort();
        }

        function populateClassDropdown() {
            const classSelect = document.getElementById('classSelect');
            globalData.classesList.forEach(cls => {
                if(cls !== "غير محدد") {
                    let opt = document.createElement('option');
                    opt.value = cls;
                    opt.textContent = cls;
                    classSelect.appendChild(opt);
                }
            });
        }

        // ==========================================
        // أحداث واجهة المستخدم (Events)
        // ==========================================
        const searchInput = document.getElementById('searchInput');
        const searchResults = document.getElementById('searchResults');
        const clearSearchBtn = document.getElementById('clearSearch');
        const classSelect = document.getElementById('classSelect');
        const studentSelect = document.getElementById('studentSelect');

        // البحث النصي الذكي
        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.trim();
            searchResults.innerHTML = '';
            
            if (query.length > 0) {
                clearSearchBtn.classList.remove('hidden');
                
                // فلترة تعتمد على الاسم أو الرقم الشخصي
                const matches = searchableStudents.filter(s => 
                    s.name.includes(query) || s.cpr.includes(query)
                ).slice(0, 10); // عرض أول 10 نتائج فقط لعدم الإثقال

                if (matches.length > 0) {
                    searchResults.classList.remove('hidden');
                    matches.forEach(match => {
                        const div = document.createElement('div');
                        div.className = 'p-3 border-b border-gray-100 hover:bg-primary-50 cursor-pointer flex flex-col transition-colors';
                        div.innerHTML = `
                            <span class="font-bold text-gray-800 text-sm">${match.name}</span>
                            <div class="flex justify-between mt-1 text-xs text-gray-500">
                                <span><i class="fa-solid fa-id-card text-gray-400"></i> ${match.cpr}</span>
                                <span class="bg-gray-200 px-2 py-0.5 rounded text-gray-700">${match.class}</span>
                            </div>
                        `;
                        div.addEventListener('click', () => {
                            searchInput.value = match.name;
                            searchResults.classList.add('hidden');
                            loadStudentProfile(match);
                        });
                        searchResults.appendChild(div);
                    });
                } else {
                    searchResults.classList.remove('hidden');
                    searchResults.innerHTML = '<div class="p-4 text-center text-sm font-bold text-red-500">لا توجد نتائج مطابقة</div>';
                }
            } else {
                clearSearchBtn.classList.add('hidden');
                searchResults.classList.add('hidden');
            }
        });

        clearSearchBtn.addEventListener('click', () => {
            searchInput.value = '';
            searchResults.classList.add('hidden');
            clearSearchBtn.classList.add('hidden');
            document.getElementById('studentProfile').classList.add('hidden');
        });

        // إغلاق قائمة البحث عند النقر خارجها
        document.addEventListener('click', (e) => {
            if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
                searchResults.classList.add('hidden');
            }
        });

        // تصفية بالصف
        classSelect.addEventListener('change', (e) => {
            const selectedClass = e.target.value;
            studentSelect.innerHTML = '<option value="">-- اختر الطالب --</option>';
            
            if (selectedClass) {
                const studentsInClass = searchableStudents.filter(s => s.class === selectedClass)
                                        .sort((a,b) => a.name.localeCompare(b.name, 'ar'));
                
                studentsInClass.forEach(s => {
                    let opt = document.createElement('option');
                    opt.value = s.name; // استخدام الاسم كمعرف
                    opt.textContent = s.name;
                    studentSelect.appendChild(opt);
                });
                studentSelect.disabled = false;
                studentSelect.classList.remove('bg-gray-100', 'cursor-not-allowed');
                studentSelect.classList.add('bg-white', 'focus:ring-2', 'focus:ring-primary-500');
            } else {
                studentSelect.disabled = true;
                studentSelect.classList.add('bg-gray-100', 'cursor-not-allowed');
                studentSelect.classList.remove('bg-white', 'focus:ring-2', 'focus:ring-primary-500');
                document.getElementById('studentProfile').classList.add('hidden');
            }
        });

        studentSelect.addEventListener('change', (e) => {
            const studentName = e.target.value;
            if (studentName) {
                const student = searchableStudents.find(s => s.name === studentName);
                if(student) loadStudentProfile(student);
            } else {
                document.getElementById('studentProfile').classList.add('hidden');
            }
        });

        // ==========================================
        // بناء وعرض الملف الشخصي
        // ==========================================
        function loadStudentProfile(student) {
            document.getElementById('profileName').textContent = student.name;
            document.getElementById('profileClass').textContent = student.class;
            document.getElementById('profileCpr').textContent = student.cpr;

            // تنظيف الاسم لتطابقه مع السجلات
            const cleanName = student.name.replace(/^[\d\s._-]+/, '').trim();

            // 1. تجميع الغياب والأعذار
            let studentAbsences = globalData.absences.filter(r => r.studentName.includes(cleanName));
            let studentExcuses = globalData.excuses.filter(e => e.studentName.includes(cleanName));
            
            // دمج الغياب والأعذار لعدم التكرار (نعرض الغياب، وإذا كان له عذر نعرضه)
            let combinedAbsences = [];
            studentAbsences.forEach(abs => {
                let excuseForThisDate = studentExcuses.find(e => e.date === abs.date);
                combinedAbsences.push({
                    date: abs.date,
                    details: excuseForThisDate ? `عذر مقدم: ${excuseForThisDate.reason}` : (abs.excuseType ? abs.excuseType : "غياب غير مبرر")
                });
            });
            // إضافة الأعذار التي ليس لها سجل غياب مباشر (إن وجدت)
            studentExcuses.forEach(exc => {
                if(!combinedAbsences.find(a => a.date === exc.date)) {
                    combinedAbsences.push({ date: exc.date, details: `عذر مقدم: ${exc.reason}` });
                }
            });

            // 2. تجميع التأخير
            let studentLates = globalData.lates.filter(l => l.studentName.includes(cleanName));

            // 3. تجميع المخالفات
            let studentViolations = globalData.violations.filter(v => v.studentName.includes(cleanName));

            // عرض الجداول
            document.getElementById('absencesCount').textContent = combinedAbsences.length;
            renderTable('absencesTable', combinedAbsences, ['date', 'details'], "لا توجد سجلات غياب");

            document.getElementById('latesCount').textContent = studentLates.length;
            renderTable('latesTable', studentLates, ['date', 'excuseType'], "لا يوجد تأخير مسجل");

            document.getElementById('violationsCount').textContent = studentViolations.length;
            renderTable('violationsTable', studentViolations, ['date', 'supervisor', 'violationType', 'actionTaken'], "لا توجد مخالفات سلوكية");

            // إظهار القسم بأنيميشن
            const profile = document.getElementById('studentProfile');
            profile.classList.remove('hidden');
        }

        // دالة مساعدة لطباعة الجداول
        function renderTable(tbodyId, dataArray, keys, emptyMessage) {
            const tbody = document.getElementById(tbodyId);
            tbody.innerHTML = '';
            
            if (dataArray.length === 0) {
                tbody.innerHTML = `<tr><td colspan="${keys.length}" class="p-6 text-center text-gray-400 font-bold bg-gray-50/50">${emptyMessage}</td></tr>`;
                return;
            }

            // ترتيب زمني تنازلي (الأحدث أولاً) إن أمكن
            dataArray.sort((a,b) => new Date(b.date) - new Date(a.date));

            dataArray.forEach(item => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-blue-50/50 transition-colors";
                
                keys.forEach(key => {
                    const td = document.createElement('td');
                    td.className = "p-4 border-b border-gray-100 text-gray-700";
                    if (key === 'date') {
                        td.innerHTML = `<span class="bg-gray-100 border border-gray-200 text-gray-600 px-2 py-1 rounded font-mono text-sm">${item[key] || '-'}</span>`;
                    } else {
                        td.textContent = item[key] || '-';
                    }
                    tr.appendChild(td);
                });
                tbody.appendChild(tr);
            });
        }

        // ==========================================
        // أدوات مساعدة (UI Utils)
        // ==========================================
        function showLoading(show) {
            document.getElementById('loadingOverlay').style.display = show ? 'flex' : 'none';
        }

        function showToast(message, type = "success") {
            const toast = document.getElementById('toast');
            const icon = document.getElementById('toastIcon');
            
            toast.className = `fixed bottom-6 left-6 px-6 py-4 rounded-xl shadow-2xl flex items-center gap-3 transition-all duration-300 z-50 text-white font-sans ${type === 'success' ? 'bg-green-600' : 'bg-red-600'}`;
            icon.className = `text-2xl fa-solid ${type === 'success' ? 'fa-circle-check' : 'fa-triangle-exclamation'}`;
            document.getElementById('toastMessage').textContent = message;
            
            toast.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
            
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
            }, 3500);
        }
    </script>
</body>
</html>
